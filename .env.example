# Copy to .env and edit. Do NOT commit a real .env file.

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cmg-demo-pass
NEO4J_DATABASE=neo4j

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cmg
POSTGRES_USER=cmg
POSTGRES_PASSWORD=cmg-demo-pass

# --- Data paths ---
CMG_DATA_RAW=./data/raw
CMG_DATA_PROCESSED=./data/processed
CMG_DATA_SYNTHETIC=./data/synthetic

# --- Models ---
CMG_ARTIFACTS=./artifacts
CMG_RANDOM_SEED=42
