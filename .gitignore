# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Notebook checkpoints
.ipynb_checkpoints/

# OS junk
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Project data — never commit real patient data
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep
# synthetic outputs are reproducible from the generator, no need to commit
data/synthetic/*.csv
data/synthetic/*.parquet

# artifacts are reproducible; only commit the deterministic JSON summaries
artifacts/*/*.joblib
artifacts/*/*.pt
artifacts/*/shap_values.parquet
artifacts/*/*_predictions.parquet

# Model artefacts
artifacts/
mlruns/
*.ckpt
*.pt
*.joblib

# Secrets and env
.env
.env.local

# Coverage and cache
.coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/

# Neo4j / Postgres local state
.neo4j/
.postgres/
